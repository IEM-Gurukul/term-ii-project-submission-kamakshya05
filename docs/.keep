                     +----------------------+
                     |        Task          |   <<abstract>>
                     +----------------------+
                     | - title: String      |
                     | - deadline: String   |
                     | - priority: int      |
                     | - completed: boolean |
                     +----------------------+
                     | + markComplete()     |
                     | + calculatePriority()|
                     | + getDetails()       |
                     +-----------▲----------+
                                 |
                     +----------------------+
                     |    PriorityTask      |
                     +----------------------+
                     | - extraPriority: int |
                     +----------------------+
                     | + calculatePriority()|
                     +----------------------+


                     +----------------------+
                     |      Reminder        |
                     +----------------------+
                     | - reminderTime       |
                     +----------------------+
                     | + setReminder()      |
                     | + notifyUser()       |
                     +----------------------+


                     +----------------------+
                     |        Stats         |
                     +----------------------+
                     | - totalTasks         |
                     | - completedTasks     |
                     +----------------------+
                     | + calculateStats()   |
                     | + displayStats()     |
                     +----------------------+


                     +----------------------+
                     |       Storage        |
                     +----------------------+
                     |                      |
                     +----------------------+
                     | + saveTasks(List)    |
                     | + loadTasks()        |
                     +----------------------+


                     +----------------------+
                     |    UserInterface     |
                     +----------------------+
                     |                      |
                     +----------------------+
                     | + showMenu()         |
                     | + getUserInput()     |
                     | + displayTasks()     |
                     +----------------------+


                     +----------------------+
                     |         Main         |
                     +----------------------+
                     |                      |
                     +----------------------+
                     | + main(String[] args)|
                     +----------------------+
                     | Uses UserInterface   |
                     | Uses Storage         |
                     | Uses Stats           |
                     +----------------------+
